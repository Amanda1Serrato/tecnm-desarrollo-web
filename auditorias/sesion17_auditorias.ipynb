## 3. Código Devuelto por el Modelo
```python
%%writefile app.py
from fastapi import FastAPI, Depends, HTTPException, status
from fastapi.security import OAuth2PasswordBearer
from pydantic import BaseModel
from jose import jwt, JWTError
from datetime import datetime, timedelta, timezone

app = FastAPI(title="API de Control de Acceso RBAC")

SECRET_KEY = "clave_secreta_sesion17"
ALGORITHM = "HS256"

oauth2_scheme = OAuth2PasswordBearer(tokenUrl="/api/token")

# Usuarios de prueba
usuarios = {
    "admin": {
        "password": "admin123",
        "rol": "admin"
    },
    "ana": {
        "password": "secreta",
        "rol": "user"
    }
}

# Modelo para recibir los datos de inicio de sesión
class Login(BaseModel):
    usuario: str
    password: str


# Crear token JWT
def crear_token(usuario, rol):
    datos = {
        "sub": usuario,
        "rol": rol,
        "exp": datetime.now(timezone.utc) + timedelta(minutes=30)
    }

    return jwt.encode(datos, SECRET_KEY, algorithm=ALGORITHM)


# Inicio de sesión
@app.post("/api/token")
def iniciar_sesion(datos: Login):
    usuario = usuarios.get(datos.usuario)

    if not usuario or usuario["password"] != datos.password:
        raise HTTPException(
            status_code=401,
            detail="Usuario o contraseña incorrectos"
        )

    token = crear_token(datos.usuario, usuario["rol"])

    return {
        "access_token": token,
        "token_type": "bearer"
    }


# Verificar token y obtener usuario
def obtener_usuario_actual(token: str = Depends(oauth2_scheme)):
    try:
        datos = jwt.decode(
            token,
            SECRET_KEY,
            algorithms=[ALGORITHM]
        )

        nombre = datos.get("sub")
        rol = datos.get("rol")

        if nombre not in usuarios or rol != usuarios[nombre]["rol"]:
            raise HTTPException(
                status_code=401,
                detail="Token no válido"
            )

        return {
            "usuario": nombre,
            "rol": rol
        }

    except JWTError:
        raise HTTPException(
            status_code=401,
            detail="Token no válido"
        )


# Panel administrativo
@app.get("/api/admin/panel")
def panel_admin(usuario: dict = Depends(obtener_usuario_actual)):

    if usuario["rol"] != "admin":
        raise HTTPException(
            status_code=403,
            detail="No tienes permiso para acceder"
        )

    return {"panel": "admin"}


# Perfil de cualquier usuario autenticado
@app.get("/api/perfil")
def perfil(usuario: dict = Depends(obtener_usuario_actual)):

    return {
        "usuario": usuario["usuario"],
        "rol": usuario["rol"]
    }

==============================================================================
VERIFICACIÓN DEL RESULTADO · 6 casos · app.py
==============================================================================
✅ 01. El administrador obtiene su token
✅ 02. El usuario normal obtiene su token
✅ 03. El admin entra al panel
✅ 04. El usuario normal recibe 403
✅ 05. Sin token recibe 401
✅ 06. El perfil funciona para el usuario normal
------------------------------------------------------------------------------
RESULTADO: 6/6 casos correctos. ¡Resultado logrado!
```

